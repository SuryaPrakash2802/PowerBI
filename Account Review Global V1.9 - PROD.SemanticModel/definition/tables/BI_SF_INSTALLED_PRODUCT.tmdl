				    Source = Sql.Database("azwemisqldcoe.0f9aff9ccbfc.database.windows.net", "DCOE", [Query="SELECT I.[Id]#(lf)      ,I.[Name]#(lf)      ,I.[CreatedDate]#(lf)      ,I.[SVMXC__Date_Installed__c]#(lf)      ,I.[SVMXC__Company__c]#(lf)      ,I.[SVMXC__Product_Name__c]#(lf)      ,I.[SVMXC__Product__c]#(lf)      ,I.[SVMXC__Service_Contract__c]#(lf)      ,I.[SVMXC__Site__c]#(lf)      ,I.[SVMXC__Warranty_End_Date__c]#(lf)      ,I.[SVMXC__Warranty_Start_Date__c]#(lf)      ,I.[SVMXC__Warranty__c]#(lf)      ,I.[SVMXC__Status__c]#(lf)      ,I.[Product_Line__c]#(lf)      ,I.[isPrinter__c]#(lf)      ,I.[is_Active__c]#(lf)      ,#(lf)#(tab)#(tab)CASE#(lf)#(tab)#(tab)#(tab)WHEN Last_Warranty_End_Date__c > CAST(GETDATE() AS date)#(lf)#(tab)#(tab)#(tab)#(tab)THEN CONVERT(varchar(10), Last_Warranty_End_Date__c, 23)#(lf)#(tab)#(tab)#(tab)ELSE 'Expired'#(lf)#(tab)#(tab)END AS Warranty_Status#(lf)      ,I.[Unique_Printer_Serial_nr__c]#(lf)      ,I.[Unique_always__c]#(lf)      ,I.[Ink_Type__c]#(lf)      ,I.[Nozzle__c]#(lf)      ,I.[Trial_Printer__c]#(lf)      ,I.[isInstalledBase__c]#(lf)      ,I.[Age__c]#(lf)      ,I.[Product_Family__c]#(lf)      ,I.[Product_Technology__c]#(lf)      ,I.[Software_Version__c]#(lf)      ,I.[Printer_Family__c]#(lf)      ,#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN I.Cloud_Connect_Status__c IS NULL #(lf)#(tab)#(tab)#(tab)#(tab) OR LTRIM(RTRIM(Cloud_Connect_Status__c)) = '' #(lf)#(tab)#(tab)#(tab)THEN 'Cloud Record Unavailable'#(lf)#(tab)#(tab)#(tab)ELSE I.Cloud_Connect_Status__c#(lf)#(tab)#(tab)END AS Cloud_Connect_Status__c#(lf)#(lf)#(tab)  ,C.Name AS Contract_Name#(lf)#(tab)  ,C.SVMXC__Start_Date__c AS Contract_Start_Date#(lf)#(tab)  ,C.End_Date_1__c AS Contract_End_Date#(lf)#(tab)  ,COALESCE(C.SVMXC__Active__c, 0) AS Contract_Active_Flag#(lf)          ,C.Contract_Type__c#(lf)  FROM [DCOE].[dbo].[ods_sf_installed_product] I#(lf)  LEFT JOIN [DCOE].[dbo].[ods_sf_service_maint_contract] C#(lf)  ON I.SVMXC__Service_Contract__c = C.Id#(lf)  WHERE Domino_Sub__c IN ('Domino UK', 'Domino BE/LUX', 'Domino US', 'Domino FR', 'Domino NL', 'Domino CA')", CommandTimeout=#duration(0, 0, 25, 0)]),
