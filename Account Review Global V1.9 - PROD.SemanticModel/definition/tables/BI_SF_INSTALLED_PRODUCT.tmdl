table BI_SF_INSTALLED_PRODUCT
	lineageTag: db85b59a-09ec-4896-83d5-a618551d724f

	measure 'Count of NAME % difference from Hours' =
			
			VAR __BASELINE_VALUE = SUM('BI_SV_SALES_TO_INSTALL_DTL'[Hours])
			VAR __VALUE_TO_COMPARE = DISTINCTCOUNT('BI_SF_INSTALLED_PRODUCT'[NAME])
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__BASELINE_VALUE, __BASELINE_VALUE + __VALUE_TO_COMPARE)
				)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7cd62aaa-950a-4050-9217-7b4c4a0d6917

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalPercentageDifference"
				}

