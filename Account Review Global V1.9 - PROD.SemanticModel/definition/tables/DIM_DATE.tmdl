	hierarchy 'Year Hierarchy'
		lineageTag: 9dcaa28f-0f3a-4dff-8079-afd77562a975

		level Year
			lineageTag: ca565a46-1555-4ad8-a653-4d0d4bf2ac8a
			column: Year

		level Quarter
			lineageTag: 595295ef-313f-4575-a634-275a49609256
			column: Quarter

		level 'Month Name'
			lineageTag: a99f3c4d-0758-4911-bc70-24fdcedac31e
			column: 'Month Name'

		level Date
			lineageTag: 8821a743-128a-4cd3-8687-b884bc9501b5
			column: Date

	partition DIM_DATE = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(1995, 1, 1), DATE(2028, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter Number", QUARTER([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Short Month", FORMAT([Date], "MMM"),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Short Day", FORMAT([Date], "ddd"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				    "Week", WEEKNUM([Date])
				)

	annotation PBI_Id = b8bd364d4d77424da6740930395594e4

