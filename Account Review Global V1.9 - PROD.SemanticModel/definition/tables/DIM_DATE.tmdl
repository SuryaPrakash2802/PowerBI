	column DateKey =
			
			VAR dt = 'DIM_DATE'[Date]         -- replace with your column name
			RETURN
			    IF (
			        ISBLANK ( dt ),              -- keep blanks blank
			        BLANK (),
			        YEAR ( dt ) * 10000          -- YYYY
			        + MONTH ( dt ) * 100         --   MM
			        + DAY ( dt )                 --     DD
			    )
		formatString: 0
		lineageTag: 92a232f9-9df3-4840-a73d-66171e513c41
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

