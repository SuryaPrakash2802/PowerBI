	column HOURS_AGGREGATED = SUMX(DISTINCT(BI_SV_SALES_TO_INSTALL_DTL[WO_MACHINE_KEY]), CALCULATE(SUM(BI_SV_SALES_TO_INSTALL_DTL[Hours]), BI_SV_SALES_TO_INSTALL_DTL[LINE_TYPE] = "Labor", USERELATIONSHIP(DIM_CALENDAR_REFERENCE[DATE_REEFRENCE], BI_SV_SALES_TO_INSTALL_DTL[SCHEDULED_DATE])))
