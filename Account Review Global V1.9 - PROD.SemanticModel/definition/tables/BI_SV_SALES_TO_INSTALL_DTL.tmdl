	column DateKey =
			
			VAR dt = BI_SV_SALES_TO_INSTALL_DTL[created_date]         -- replace with your column name
			RETURN
			    IF (
			        ISBLANK ( dt ),              -- keep blanks blank
			        BLANK (),
			        YEAR ( dt ) * 10000          -- YYYY
			        + MONTH ( dt ) * 100         --   MM
			        + DAY ( dt )                 --     DD
			    )
		formatString: 0
		lineageTag: 8e6d3f07-3031-4a54-bc84-79f936ed3104
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

