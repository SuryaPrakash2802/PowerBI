	column DateKey =
			
			VAR dt = 'BI_SVTLY_PRINTER_STATES'[LOAD_DATE]         -- replace with your column name
			RETURN
			    IF (
			        ISBLANK ( dt ),              -- keep blanks blank
			        BLANK (),
			        YEAR ( dt ) * 10000          -- YYYY
			        + MONTH ( dt ) * 100         --   MM
			        + DAY ( dt )                 --     DD
			    )
		formatString: 0
		lineageTag: 7cfb25d7-a3e1-4b72-aaf8-4745d12ed37d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

