				    Source = Sql.Database("azwemisqldcoe.0f9aff9ccbfc.database.windows.net", "DCOE_PR_CLOUD_DATA", [Query="WITH main AS (#(lf)#(tab)SELECT #(lf)#(tab)#(tab)ID,#(lf)#(tab)#(tab)LOAD_DATE,#(lf)#(tab)#(tab)COMPUTATIONTS,#(lf)#(tab)#(tab)OFFLINE,#(lf)#(tab)#(tab)PRINTING,#(lf)#(tab)#(tab)READY_TO_PRINT,#(lf)#(tab)#(tab)FAULT,#(lf)#(tab)#(tab)PRINTER_IDLE,#(lf)#(tab)#(tab)SEQUENCING_ON,#(lf)#(tab)#(tab)SEQUENCING_OFF,#(lf)#(tab)#(tab)JET_RUNNING,#(lf)#(tab)#(tab)FAST_PAUSE,#(lf)#(tab)#(tab)PRINTING_AND_WARNING,#(lf)        PRINTING_AND_FAULT,#(lf)        STANDBY,#(lf)        WARNING,#(lf)        POWERED_ON,#(lf)        UNKNOWN,#(lf)        PRINTING_DISABLED,#(lf)        IDLE,#(lf)        MANUAL,#(lf)#(tab)#(tab)LAG(OFFLINE, 1, OFFLINE) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                           AS PreviousOFFLINE,#(lf)#(tab)#(tab)LAG(PRINTING, 1, PRINTING) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                         AS PreviousPRINTING,#(lf)#(tab)#(tab)LAG(READY_TO_PRINT, 1, READY_TO_PRINT) OVER (PARTITION BY ID ORDER BY LOAD_DATE)             AS PreviousREADY_TO_PRINT,#(lf)#(tab)#(tab)LAG(FAULT, 1, FAULT) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                               AS PreviousFAULT,#(lf)#(tab)#(tab)LAG(PRINTER_IDLE, 1, PRINTER_IDLE) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                 AS PreviousPRINTER_IDLE,#(lf)#(tab)#(tab)LAG(SEQUENCING_ON, 1, SEQUENCING_ON) OVER (PARTITION BY ID ORDER BY LOAD_DATE)               AS PreviousSEQUENCING_ON,#(lf)#(tab)#(tab)LAG(SEQUENCING_OFF, 1, SEQUENCING_OFF) OVER (PARTITION BY ID ORDER BY LOAD_DATE)             AS PreviousSEQUENCING_OFF,#(lf)#(tab)#(tab)LAG(JET_RUNNING, 1, JET_RUNNING) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                   AS PreviousJET_RUNNING,#(lf)#(tab)#(tab)LAG(FAST_PAUSE, 1, FAST_PAUSE) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                     AS PreviousFAST_PAUSE,#(lf)#(tab)#(tab)LAG(PRINTING_AND_WARNING, 1, PRINTING_AND_WARNING) OVER (PARTITION BY ID ORDER BY LOAD_DATE) AS PreviousPRINTING_AND_WARNING,#(lf)#(tab)#(tab)LAG(PRINTING_AND_FAULT, 1, PRINTING_AND_FAULT) OVER (PARTITION BY ID ORDER BY LOAD_DATE)     AS PreviousPRINTING_AND_FAULT,#(lf)#(tab)#(tab)LAG(STANDBY, 1, STANDBY) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                           AS PreviousSTANDBY,#(lf)#(tab)#(tab)LAG(WARNING, 1, WARNING) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                           AS PreviousWARNING,#(lf)#(tab)#(tab)LAG(POWERED_ON, 1, POWERED_ON) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                     AS PreviousPOWERED_ON,#(lf)#(tab)#(tab)LAG(UNKNOWN, 1, UNKNOWN) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                           AS PreviousUNKNOWN,#(lf)#(tab)#(tab)LAG(PRINTING_DISABLED, 1, PRINTING_DISABLED) OVER (PARTITION BY ID ORDER BY LOAD_DATE)       AS PreviousPRINTING_DISABLED,#(lf)#(tab)#(tab)LAG(IDLE, 1, IDLE) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                                 AS PreviousIDLE,#(lf)#(tab)#(tab)LAG(MANUAL, 1, MANUAL) OVER (PARTITION BY ID ORDER BY LOAD_DATE)                             AS PreviousMANUAL#(lf)#(tab)FROM [DCOE_PR_CLOUD_DATA].[dbo].[BI_SVTLY_THINGS_OVERALL_STATUSES_COUNTERS_ALGO_PROP]#(lf)#(tab)WHERE LOAD_DATE >= DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) -12, 0)#(lf)#(tab)#(tab)--AND ID = '6008912fe49b8b0001228ba1'#(lf)#(tab)),#(lf)#(lf)cte1 AS (#(lf)#(lf)#(tab)SELECT#(lf)#(tab)#(tab)ID,#(lf)#(tab)#(tab)LOAD_DATE,#(lf)#(tab)#(tab)COMPUTATIONTS,#(lf)#(tab)#(tab)(OFFLINE - PreviousOFFLINE)/3600/1000                           AS dayOFFLINE,#(lf)#(tab)#(tab)(PRINTING - PreviousPRINTING)/3600/1000                         AS dayPRINTING,#(lf)#(tab)#(tab)(READY_TO_PRINT - PreviousREADY_TO_PRINT)/3600/1000             AS dayREADY_TO_PRINT,#(lf)#(tab)#(tab)(FAULT - PreviousFAULT)/3600/1000                               AS dayFAULT,#(lf)#(tab)#(tab)(PRINTER_IDLE - PreviousPRINTER_IDLE)/3600/1000                 AS dayPRINTER_IDLE,#(lf)#(tab)#(tab)(SEQUENCING_ON - PreviousSEQUENCING_ON)/3600/1000               AS daySEQUENCING_ON,#(lf)#(tab)#(tab)(SEQUENCING_OFF - PreviousSEQUENCING_OFF)/3600/1000             AS daySEQUENCING_OFF,#(lf)#(tab)#(tab)(JET_RUNNING - PreviousJET_RUNNING)/3600/1000                   AS dayJET_RUNNING,#(lf)#(tab)#(tab)(FAST_PAUSE - PreviousFAST_PAUSE)/3600/1000                     AS dayFAST_PAUSE,#(lf)#(tab)#(tab)(PRINTING_AND_WARNING - PreviousPRINTING_AND_WARNING)/3600/1000 AS dayPRINTING_AND_WARNING,#(lf)#(tab)#(tab)(PRINTING_AND_FAULT - PreviousPRINTING_AND_FAULT)/3600/1000     AS dayPRINTING_AND_FAULT,#(lf)#(tab)#(tab)(WARNING - PreviousWARNING)/3600/1000                           AS dayWARNING,#(lf)#(tab)#(tab)(POWERED_ON - PreviousPOWERED_ON)/3600/1000                     AS dayPOWERED_ON,#(lf)#(tab)#(tab)(UNKNOWN - PreviousUNKNOWN)/3600/1000                           AS dayUNKNOWN,#(lf)#(tab)#(tab)(PRINTING_DISABLED - PreviousPRINTING_DISABLED)/3600/1000       AS dayPRINTING_DISABLED,#(lf)#(tab)#(tab)(IDLE - PreviousIDLE)/3600/1000                                 AS dayIDLE,#(lf)#(tab)#(tab)(MANUAL - PreviousMANUAL)/3600/1000                             AS dayMANUAL#(lf)#(tab)FROM main#(lf)#(tab)--ORDER BY ID, LOAD_DATE#(lf))#(lf)#(lf)SELECT #(lf)#(tab)*,#(lf)#(tab)[dayPRINTING] + [dayREADY_TO_PRINT] AS ALEKS_available_hours,#(lf)#(tab)[dayPRINTING] + [dayREADY_TO_PRINT] + [dayFAULT] AS ALEKS_available_plus_fault,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN [dayPRINTING] + [dayREADY_TO_PRINT] + [dayFAULT] <> 0#(lf)#(tab)#(tab)#(tab)THEN 100*([dayPRINTING] + [dayREADY_TO_PRINT] + [dayFAULT]) / ([dayPRINTING] + [dayREADY_TO_PRINT] + [dayFAULT])#(lf)#(tab)#(tab)ELSE NULL#(lf)#(tab)END AS ALEKS_uptime_percentage#(lf)FROM cte1#(lf)ORDER BY ID, LOAD_DATE", CommandTimeout=#duration(0, 0, 25, 0)])
				in
