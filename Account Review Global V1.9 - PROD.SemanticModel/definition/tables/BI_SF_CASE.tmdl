	column DateKey =
			
			VAR dt = BI_SF_CASE[ClosedDate]         -- replace with your column name
			RETURN
			    IF (
			        ISBLANK ( dt ),              -- keep blanks blank
			        BLANK (),
			        YEAR ( dt ) * 10000          -- YYYY
			        + MONTH ( dt ) * 100         --   MM
			        + DAY ( dt )                 --     DD
			    )
		formatString: 0
		lineageTag: 83f29ce2-30d7-4ce6-bc3e-1ad30b174e18
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

