table 'Measures Table'
	lineageTag: a4ec75a9-6cbe-4c97-9fba-2149a4dc288e

	measure 'Rolling 12M NPS %' = ```
			
			VAR EndDateKey = CALCULATE( MAX ( SurveyFeedback[DateKey] ), REMOVEFILTERS( 'DIM_DATE' ) )
			VAR EndDate = LOOKUPVALUE( DIM_DATE[Date], DIM_DATE[DateKey], EndDateKey )
			RETURN
			IF( 
			    ISBLANK( EndDate ),
			    BLANK(),
			    CALCULATE( [NPS%], REMOVEFILTERS( 'DIM_DATE' ), DATESINPERIOD( 'DIM_DATE'[Date], EndDate, -12, MONTH )
			    )
			)
			```
		lineageTag: 0a3ea14e-771b-4e49-8b76-d95157959921

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Uptime Percentage' = ```
			
			    DIVIDE(
			        SUM ( BI_SVTLY_PRINTER_STATES[ALEKS_available_hours] ),
			        SUM ( BI_SVTLY_PRINTER_STATES[ALEKS_available_plus_fault]),
			        0
			    )
			```
		lineageTag: f6f3a1de-d90d-4650-94a7-62cf83cf1bcd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Uptime Percentage of Printers Connected 12M Atleast' = ```
			
			CALCULATE( [Uptime Percentage], FILTER( 'BI_SVTLY_THINGS', BI_SVTLY_THINGS[ACTIVATIONDATE] <= EDATE( TODAY(), -12 ) 
			        && BI_SVTLY_THINGS[LATESTMETRICVALUETIMESTAMP] >= EDATE( TODAY(), -6 )) ) --has received telemetry data in the last 6 months
			```
		lineageTag: 40592758-e084-4f6f-974c-587bf902269b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KMS Fix % (Last 12 Months)' =
			
			VAR EndDate =
			    MIN (
			        MAX ( 'DIM_DATE'[Date] ),
			        TODAY ()
			    )
			RETURN
			    CALCULATE (
			        [kms %],
			        DATESINPERIOD ( 'DIM_DATE'[Date], EndDate, -12, MONTH )
			    )
		lineageTag: 2878be09-bb4a-4ee6-86d8-1be18e16f108

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NPS (Last 12 Months)' =
			
			VAR EndDate =
			    MIN (
			        MAX ( 'DIM_DATE'[Date] ),
			        TODAY ()
			    )
			RETURN
			    CALCULATE (
			        [NPS%],
			        DATESINPERIOD ( 'DIM_DATE'[Date], EndDate, -12, MONTH )
			    ) * 100
		lineageTag: ec24023c-cc1f-4839-ac5e-c860baec9471

		annotation PBI_FormatHint = {"isGeneralNumber":true}

