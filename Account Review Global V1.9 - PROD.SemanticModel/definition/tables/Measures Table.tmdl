	measure 'Repair hours' =
			CALCULATE( DIVIDE(SUM(BI_SV_SALES_TO_INSTALL_DTL[line_qty]), 4)
			                                    ,BI_SV_SALES_TO_INSTALL_DTL[line_type] = "Labor"
			                                    ,BI_SV_SALES_TO_INSTALL_DTL[activity_type] = "Printer: Repair")
		lineageTag: 9d89b264-43c5-4ad7-97bf-53f858ae45e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Spares = CALCULATE( SUM(BI_SV_SALES_TO_INSTALL_DTL[line_qty]), BI_SV_SALES_TO_INSTALL_DTL[line_type] = "Parts" )
