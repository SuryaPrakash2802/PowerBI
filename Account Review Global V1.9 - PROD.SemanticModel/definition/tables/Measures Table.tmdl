	measure 'Uptime Percentage in last 12M' =
			
			CALCULATE(
			    [Uptime Percentage],
			    REMOVEFILTERS('DIM_DATE'),
			    'DIM_DATE'[Date] >= EDATE(TODAY(), -12)
			)
		lineageTag: 00723754-8f0f-4684-9085-e668c295608c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Downtime per Printer' =
			
			VAR downtime = SUM ( BI_SVTLY_ALERTS_HISTORY[DURATION_HRS] )
			VAR printer_count = CALCULATE( COUNT ( BI_SVTLY_THINGS[ID] ), FILTER( BI_SVTLY_THINGS, BI_SVTLY_THINGS[LATESTMETRICVALUETIMESTAMP] >= EDATE( TODAY(), -12 ) ) ) -- normalised printer count for only printers active in last year
			RETURN DIVIDE( downtime, printer_count )
		lineageTag: 6d566dc1-4a2b-4d6c-9110-457a14483d1f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer complaints closed in last 12M' = ```
			
			VAR startDate = EDATE(TODAY(), -12)
			RETURN
			CALCULATE(
			    COUNT(BI_SF_CASE[Id]),
			    FILTER(
			        BI_SF_CASE,
			        BI_SF_CASE[ClosedDate] >= startDate &&
			        BI_SF_CASE[ClosedDate] <= TODAY() &&
			        BI_SF_CASE[Complaint__c] = "Yes" &&      
			        NOT ISBLANK(BI_SF_CASE[Origin]) &&
			        BI_SF_CASE[Origin] <> "" &&
			        NOT (
			            BI_SF_CASE[Origin] IN {
			                "Customer Satisfaction Survey",
			                "Face-to-Face",
			                "Fax",
			                "Internal",
			                "Salesrep",
			                "Technician",
			                "Web"
			            }
			        )
			
			    )
			)
			```
		formatString: 0
		lineageTag: 3f1f035b-bf79-427b-8bd9-ddcace293234

	measure 'Open Customer complaints' = ```
			
			CALCULATE(
			    COUNT(BI_SF_CASE[Id]),
			    FILTER(
			        BI_SF_CASE,
			        BI_SF_CASE[IsClosed] = 0 &&
			        BI_SF_CASE[Complaint__c] = "Yes" &&      
			        NOT ISBLANK(BI_SF_CASE[Origin]) &&
			        BI_SF_CASE[Origin] <> "" &&
			        NOT (
			            BI_SF_CASE[Origin] IN {
			                "Customer Satisfaction Survey",
			                "Face-to-Face",
			                "Fax",
			                "Internal",
			                "Salesrep",
			                "Technician",
			                "Web"
			            }
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 9c473435-dc9c-4d7b-be07-71cfbf8938ec

	measure Banner = "To be added soon!"
		lineageTag: 8b7fe886-c6a0-4cf8-b6f9-b6adea46e67b

	measure 'Percent of Active IB on Contract' =
			
			VAR Numerator = CALCULATE(
			                    COUNTROWS( 'BI_SF_INSTALLED_PRODUCT'),
			                    KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[is_Active__c] = 1 ),
			                    KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[Contract_Active_Flag] = 1 ),
			                    KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[isPrinter__c] = 1 ),
			                    KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[isInstalledBase__c] = 1 ),
			                    KEEPFILTERS( BI_SF_INSTALLED_PRODUCT[Product_Family__c] <> "Cloud" ),
			                    KEEPFILTERS( LEN ( TRIM ( 'BI_SF_INSTALLED_PRODUCT'[SVMXC__Service_Contract__c] & "" ) ) > 0 )
			)
			VAR Denominator = CALCULATE(
			                    COUNTROWS(BI_SF_INSTALLED_PRODUCT),
			                    KEEPFILTERS(BI_SF_INSTALLED_PRODUCT[is_Active__c] = 1),
			                    KEEPFILTERS(BI_SF_INSTALLED_PRODUCT[isPrinter__c] = 1),
			                    KEEPFILTERS(BI_SF_INSTALLED_PRODUCT[isInstalledBase__c] = 1),
			                    KEEPFILTERS( BI_SF_INSTALLED_PRODUCT[Product_Family__c] <> "Cloud" )
			)
			RETURN
			    DIVIDE( Numerator, Denominator )
		lineageTag: e4a719a8-6652-4859-bdab-48ed10f9e88d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active install base count' = ```
			
			CALCULATE(
			            COUNTROWS( 'BI_SF_INSTALLED_PRODUCT'),
			            KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[is_Active__c] = 1 ),
			            KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[isPrinter__c] = 1 ),
			            KEEPFILTERS( 'BI_SF_INSTALLED_PRODUCT'[isInstalledBase__c] = 1 ),
			            
			            KEEPFILTERS(
			                NOT (
			                    'BI_SF_INSTALLED_PRODUCT'[Product_Family__c] IN {"Cloud", "Editor"}
			                )
			
			))
			```
		formatString: 0
		lineageTag: 41d69672-75f8-4d6f-b152-29efeee065f2

