	measure 'Total Support Cases Count' = ```
			
			CALCULATE(
			    COUNTROWS(BI_SF_CASE),
			    BI_SF_CASE[Type] = "Service Max",
			    NOT ISBLANK(BI_SF_CASE[Request_Type__c]), 
			    BI_SF_CASE[Phone_Fix_Resolution__c] <> "No THD Support required"
			)
			```
		formatString: 0
		lineageTag: f8854dc9-8189-49b1-900b-76922af862ec

	measure 'Remotely Fixed Support Cases Count' =
			
			CALCULATE(
			    COUNTROWS(BI_SF_CASE),
			    BI_SF_CASE[Type] = "Service Max",
			    NOT ISBLANK(BI_SF_CASE[Request_Type__c]),
			    BI_SF_CASE[Phone_Fix__c] = 1,
			    NOT ISBLANK(BI_SF_CASE[Phone_Fix_Resolution__c]),
			    BI_SF_CASE[Phone_Fix_Resolution__c] <> "No THD Support required",
			    ISBLANK(BI_SF_CASE[Work_Order_Number_del__c])
			)
		formatString: 0
		lineageTag: 9afb2e3c-0c43-4734-8315-ec30ffc5d2a0

	measure 'Non remote support cases' = [Total Support Cases Count] - [Remotely Fixed Support Cases Count]
		formatString: 0
		lineageTag: 9f49871c-a5ce-4b41-ab4e-bfc9e9d6afea

	measure 'Remote Fix % (Last 12 Months)' =
			
			VAR StartDate =
			    EDATE (
			        DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 ),
			        -12
			    )
			VAR EndDate =
			    MIN (
			        MAX ( 'DIM_DATE'[Date] ),
			        TODAY ()
			    )
			RETURN
			    CALCULATE (
			        [RemoteFix percent],
			        DATESBETWEEN (
			            'DIM_DATE'[Date],
			            StartDate,
			            EndDate
			        )
			    )
		lineageTag: bd41f9ef-b1ba-4db4-a1cc-169aa6256071

		annotation PBI_FormatHint = {"isGeneralNumber":true}

