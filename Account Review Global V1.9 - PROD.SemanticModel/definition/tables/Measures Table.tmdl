	measure 'Total Onsite Repairs Visual' =
			
			IF(
			    [Asset Belongs To Selected Account] = 1,
			    COALESCE([Total onsite repairs], 0),
			    BLANK()
			)
		formatString: 0
		lineageTag: 35f0133c-d88e-4373-9014-281f7c9b2a86

	measure 'Asset Belongs To Selected Account' =
			
			VAR RowAssetAccountID =
			    SELECTEDVALUE(BI_SF_INSTALLED_PRODUCT[SVMXC__Company__c])
			
			VAR SelectedAccountIDs =
			    VALUES(BI_SF_ACCOUNT[Id])
			
			VAR AccountFilterActive =
			    ISCROSSFILTERED(BI_SF_ACCOUNT[Id])
			        || ISCROSSFILTERED(BI_SF_ACCOUNT[Name])
			
			RETURN
			IF(
			    NOT AccountFilterActive,
			    1,
			    IF(
			        NOT ISBLANK(RowAssetAccountID)
			            && CONTAINS(
			                SelectedAccountIDs,
			                BI_SF_ACCOUNT[Id],
			                RowAssetAccountID
			            ),
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 0abb7809-a6ed-4bcd-8868-245cf53cd8f4

	measure 'Spares visual' =
			
			IF(
			    [Asset Belongs To Selected Account] = 1,
			    COALESCE([Spares], 0),
			    BLANK()
			)
		lineageTag: 43a43c48-7eeb-4b4c-b017-e11a69fd2afb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repair hours visual' =
			
