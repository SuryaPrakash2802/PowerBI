table BI_SF_SERVICE_MAINT_CONTRACT
	lineageTag: c610b959-0e2e-48fa-a87a-33ca4444f71c

	column 'PM Completed' =
			
			VAR __CurrentRowID = BI_SF_SERVICE_MAINT_CONTRACT[ID]
			RETURN
			COUNTROWS(
			    FILTER(
			        BI_SV_SALES_TO_INSTALL_DTL,AND(
			        __CurrentRowID = BI_SV_SALES_TO_INSTALL_DTL[CONTRACT_ID],AND( BI_SV_SALES_TO_INSTALL_DTL[ACTIVITY_TYPE] = "Printer: Maintenance" , BI_SV_SALES_TO_INSTALL_DTL[LINE_TYPE] = "Printer")
			    )
			))
		formatString: 0
		lineageTag: dc32d926-f39b-4c3e-bafb-18018cdcfc5c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

