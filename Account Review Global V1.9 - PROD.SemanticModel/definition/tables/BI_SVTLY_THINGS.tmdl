	partition BI_SVTLY_THINGS = m
		mode: import
		source =
				let
				    Source = Sql.Database("azwemisqldcoe.0f9aff9ccbfc.database.windows.net", "DCOE_PR_CLOUD_DATA", [Query="SELECT [ID]#(lf)      ,[NAME]#(lf)      ,[SERIALNUMBER]#(lf)      ,[ACTIVATIONDATE]#(lf)      ,[LATESTMETRICVALUETIMESTAMP]#(lf)      ,[CUSTOMER_NAME]#(lf)      , CASE#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY = 'United States' THEN 'Domino US'#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY = 'United Kingdom' THEN 'Domino UK'#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY = 'France' THEN 'Domino FR'#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY IN ('Belgium', 'Luxembourg') THEN 'Domino BE/LUX'#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY = 'Netherlands' THEN 'Domino NL'#(lf)#(tab)#(tab)#(tab)WHEN CUSTOMER_COUNTRY = 'Canada' THEN 'Domino CA'#(lf)#(tab)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END AS DOMINO_SUB#(lf)      ,[LOCATION_NAME]#(lf)      ,[PROPERTIES_PRODUCTIONTARGET]#(lf)      ,[PROPERTIES_PRINTERNAME]#(lf)      ,[PROPERTIES_TOTALPRINTCOUNT]#(lf)      ,[THINGDEFINITION_NAME]#(lf)      ,[THINGDEFINITION_PROPERTIES_PRINTERSERIES]#(lf)      ,[LAST_UPDATE_TS]#(lf)  FROM [DCOE_PR_CLOUD_DATA].[dbo].[BI_SVTLY_THINGS]#(lf)  WHERE CUSTOMER_COUNTRY IN ('United States', 'United Kingdom', 'France', 'Belgium', 'Netherlands', 'Luxembourg', 'Canada')", CommandTimeout=#duration(0, 0, 25, 0)])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

